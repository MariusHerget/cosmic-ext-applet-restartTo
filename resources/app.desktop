[Desktop Entry]
Name=Cosmic Ext Applet Restart To
Comment=Applet that adds capability to restart to any other EFI boot entry
Type=Application
Icon=com.github.cosmic_ext.restartTo
Exec=cosmic-ext-applet-restart-to %F
Terminal=false
StartupNotify=true
Categories=COSMIC
Keywords=COSMIC
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=
